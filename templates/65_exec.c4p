# 65_exec — run ELF programs from the FAT volume: shell, ring-3 tasks.
# Build (same shape as 64_shell, plus userblob for the linked-in copy):
#   c4c --emit-c 65_exec.c4p --freestanding -o ex.c
#   gcc -m32 -ffreestanding -nostdlib -c -o ex.o ex.c -I rt
#   gcc -m32 -ffreestanding -nostdlib -c -o fs.o rt/c4rt_fs.c
#   as --32 rt/irq.s -o irq.o
#   as --32 boot/boot.s -o boot.o
#   ld -m i386pe -T boot/linkflat.ld -o ex.pe ex.o fs.o irq.o
#   objcopy -O binary ex.pe ex.bin
#   ld -m i386pe -T boot/bootlink.ld -o boot.pe boot.o
#   objcopy -O binary -j .boot boot.pe boot.bin
#   cat boot.bin ex.bin(pad 96K) fat12.bin > xdisk.img  (fat base LBA 193;
#     build fat12.bin with: python user/mkfat.py zig-out/fat12.bin user/hello.txt zig-out/user2.elf)
#   qemu-system-i386 -drive format=raw,file=xdisk.img -display none ^
#     -debugcon file:zig-out/x.log -device isa-debug-exit,iobase=0xf4,iosize=0x04 ^
#     -monitor tcp:127.0.0.1:4445,server,nowait
# Then type: run pong.elf (wait for got 1..5), ls, poweroff.
# Expect the task's output, `done`, the shell prompt again,
# qemu exit = (code<<1)|1 on poweroff.

fn ata_wait() {
  let t = 0
  while t < 100000 {
    let s = inb(503)
    if (s & 128) == 0 {
      return s
    }
    t = t + 1
  }
  fail("ata timeout")
}

fn ata_read(lba) {
  outb(502, 224 + (lba >> 24))
  outb(498, 1)
  outb(499, lba & 255)
  outb(500, (lba >> 8) & 255)
  outb(501, (lba >> 16) & 255)
  outb(503, 32)
  ata_wait()
  let t = 0
  while t < 100000 {
    let s = inb(503)
    if s & 1 {
      fail("ata err")
    }
    if s & 8 {
      break
    }
    t = t + 1
  }
  let buf = bytes(512)
  let w = 0
  while w < 256 {
    let v = inw(496)
    poke(buf, w * 2, v & 255)
    poke(buf, w * 2 + 1, (v >> 8) & 255)
    w = w + 1
  }
  return buf
}

fn rd16(buf, off) {
  return peek(buf, off) + peek(buf, off + 1) * 256
}

fn rd32(buf, off) {
  return peek(buf, off) + peek(buf, off + 1) * 256 + peek(buf, off + 2) * 65536 + peek(buf, off + 3) * 16777216
}

fn fat12(fat, cl) {
  let off = cl + floor(cl / 2)
  if cl % 2 == 0 {
    return peek(fat, off) + (peek(fat, off + 1) & 15) * 256
  }
  return (peek(fat, off) >> 4) + peek(fat, off + 1) * 16
}

fn to83(name) {
  let parts = split(name, ".")
  let a = upper(parts[0])
  let b = ""
  if len(parts) > 1 {
    b = upper(parts[1])
  }
  while len(a) < 8 {
    a = a + " "
  }
  while len(b) < 3 {
    b = b + " "
  }
  return a + b
}

fn fat_ls() {
  let root = ata_read(198)
  let e = 0
  while e < 16 {
    if peek(root, e * 32) == 0 {
      break
    }
    let nm = ""
    let k = 0
    while k < 11 {
      nm = nm + chr(peek(root, e * 32 + k))
      k = k + 1
    }
    print nm
    e = e + 1
  }
  return e
}

fn fat_read(name83) {
  let root = ata_read(198)
  let fat = ata_read(194)
  let e = 0
  while e < 16 {
    if peek(root, e * 32) == 0 {
      break
    }
    let nm = ""
    let k = 0
    while k < 11 {
      nm = nm + chr(peek(root, e * 32 + k))
      k = k + 1
    }
    if nm == name83 {
      let cl = rd16(root, e * 32 + 26)
      let sz = rd32(root, e * 32 + 28)
      let out = bytes(sz)
      let pos = 0
      while cl < 4088 {
        let sec = ata_read(197 + cl)
        let b = 0
        while b < 512 {
          if pos < sz {
            poke(out, pos, peek(sec, b))
            pos = pos + 1
          }
          b = b + 1
        }
        cl = fat12(fat, cl)
      }
      return out
    }
    e = e + 1
  }
  fail("not found")
}

fn vga_put(r, c, ch, attr) {
  let off = 753664 + (r * 80 + c) * 2
  let a = off - off % 4
  let v = peek32(a)
  let sh = (off - a) * 8
  poke32(a, setbits(v, sh + 15, sh, ch + attr * 256))
}

fn vga_clear(attr) {
  let i = 0
  while i < 500 {
    poke32(753664 + i * 4, 2097184 + attr * 16777472)
    i = i + 1
  }
}

fn vga_scroll() {
  let r = 0
  while r < 24 {
    let i = 0
    while i < 40 {
      poke32(753664 + r * 160 + i * 4, peek32(753664 + (r + 1) * 160 + i * 4))
      i = i + 1
    }
    r = r + 1
  }
  let i = 0
  while i < 40 {
    poke32(753664 + 24 * 160 + i * 4, 119539488)
    i = i + 1
  }
}

fn vga_move(r, c) {
  let pos = r * 80 + c
  outb(980, 14)
  outb(981, (pos >> 8) & 255)
  outb(980, 15)
  outb(981, pos & 255)
}

fn vga_print(s, attr, cur) {
  for ch in s {
    if ord(ch) == 10 {
      cur[1] = 0
      cur[0] = cur[0] + 1
    } else {
      vga_put(cur[0], cur[1], ord(ch), attr)
      cur[1] = cur[1] + 1
      if cur[1] == 80 {
        cur[1] = 0
        cur[0] = cur[0] + 1
      }
    }
    if cur[0] == 25 {
      vga_scroll()
      cur[0] = 24
    }
  }
  vga_move(cur[0], cur[1])
  return cur
}

# NOTE: the input loop below is inlined in the shell body on purpose.
# A `readline()` helper with `while true` + `return` misbehaves when the
# 100Hz timer preempts it under QEMU TCG (rare wrong-branch, ~5%/tick;
# invisible on real hardware and with TB chaining off). Inline spins with
# bounded conditions are solid. See DOCS "QEMU notes".

gdt_set(1, 0, 4294967295, 154, 207)
gdt_set(2, 0, 4294967295, 146, 207)
gdt_set(3, 0, 4294967295, 250, 207)
gdt_set(4, 0, 4294967295, 242, 207)
gdt_load()
tss(589824)

poke32(524288, 528387)
poke32(524292, 532487)
poke32(524296, 536583)
let i = 0
while i < 1024 {
  poke32(528384 + i * 4, i * 4096 + 3)
  i = i + 1
}
let j = 0
while j < 1024 {
  poke32(532480 + j * 4, 4194304 + j * 4096 + 7)
  poke32(536576 + j * 4, 8388608 + j * 4096 + 7)
  j = j + 1
}
cr3(524288)
pg_on()
print "exec paging on"

outb(32, 17)
outb(160, 17)
outb(33, 32)
outb(161, 40)
outb(33, 4)
outb(161, 2)
outb(33, 1)
outb(161, 1)
outb(33, 252)
outb(161, 255)
outb(67, 52)
outb(64, 155)
outb(64, 46)

idt_set(32, irq_addr(), 8, 142)
idt_set(33, irq1_addr(), 8, 142)
idt_set(128, syscall_addr(), 8, 238)
let v = 0
while v < 32 {
  idt_set(v, fault_addr(v), 8, 142)
  v = v + 1
}
idt_load()
sti()
vga_clear(7)
let cur = [0, 0]
vga_print("c4plus exec shell 0.4.0", 15, cur)
vga_print(chr(10), 7, cur)
print "shell on"
while true {
  vga_print("c4> ", 10, cur)
  let line = ""
  let gotline = 0
  while gotline == 0 {
    idle()
    let k = key()
    if k != -1 {
      if k == 10 {
        vga_print(chr(10), 7, cur)
        gotline = 1
      } else {
        if k == 8 {
          if len(line) > 0 {
            line = substr(line, 0, len(line) - 1)
            cur[1] = cur[1] - 1
            if cur[1] < 0 {
              cur[1] = 0
            } else {
              vga_put(cur[0], cur[1], 32, 7)
              vga_move(cur[0], cur[1])
            }
          }
        } else {
          line = line + chr(k)
          vga_print(chr(k), 7, cur)
        }
      }
    }
  }
  # sacrificial print: under QEMU TCG the first statement after this loop
  # exit is occasionally skipped (see DOCS "QEMU notes"); a harmless blank
  # absorbs it so real output never goes missing.
  print ""
  print ("got [" + line + "]")
  let parts = split(line, " ")
  let cmd = parts[0]
  if cmd == "help" {
    vga_print("help ls cat run clear ver poweroff", 7, cur)
    vga_print(chr(10), 7, cur)
    print "help ok"
  } elif cmd == "ls" {
    fat_ls()
    print "ls ok"
  } elif cmd == "cat" {
    if len(parts) > 1 {
      let data = fat_read(to83(parts[1]))
      let s = ""
      let k = 0
      while k < len(data) {
        s = s + chr(peek(data, k))
        k = k + 1
      }
      vga_print(s, 7, cur)
      print "cat ok"
    } else {
      vga_print("usage: cat file", 7, cur)
      vga_print(chr(10), 7, cur)
    }
  } elif cmd == "run" {
    if len(parts) > 1 {
      let data = fat_read(to83(parts[1]))
      if peek(data, 0) == 127 and peek(data, 1) == 69 {
        let e = elf_load(flat(data))
        print ("entry=" + str(e))
        let t = task_create(e, 8388608)
        print ("task=" + str(t))
        while tasks() > 0 {
          idle()
        }
        vga_print("done", 7, cur)
        vga_print(chr(10), 7, cur)
        print "run ok"
      } else {
        vga_print("not an elf", 7, cur)
        vga_print(chr(10), 7, cur)
      }
    } else {
      vga_print("usage: run file", 7, cur)
      vga_print(chr(10), 7, cur)
    }
  } elif cmd == "clear" {
    vga_clear(7)
    cur[0] = 0
    cur[1] = 0
  } elif cmd == "ver" {
    vga_print("c4plus 0.4.0 exec", 7, cur)
    vga_print(chr(10), 7, cur)
    print "ver ok"
  } elif cmd == "poweroff" {
    print "bye"
    exit(0)
  } else {
    if len(line) > 0 {
      vga_print("unknown cmd", 7, cur)
      vga_print(chr(10), 7, cur)
    }
  }
}

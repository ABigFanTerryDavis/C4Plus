# 36_emit — compile C4Plus to a native binary (transpiler v1)
#
#   c4c --emit-c 36_emit.c4p -o hello.c
#   gcc -std=c99 -I rt -o hello hello.c rt/c4rt.c -lm
#   ./hello
#
# v1 compiles: vars, math+bits, strings, lists, dicts, structs,
# if/elif/else, while, for, break/continue, functions, switch,
# print, input, args, exit, os.*, physics.*, time.*, math builtins.
# v1 says no (clean error) to: try/catch, json.*, heap.*, cpu.*.
# Notes: and/or evaluate both sides; floats may differ in the
# last printed digit vs script mode (same value, other printer).

fn fact(n) {
  if n == 0 {
    return 1
  }
  return n * fact(n - 1)
}

struct Point { x, y }
let p = Point(3, 4)
print fact(5)
print p.x
for i in 1..3 {
  print (i * i)
}
asm("nop")
print "native-ready"

# 23_switch_range_nil — switch, ranges, nil/type
let day = 7
switch day {
  1, 7 {
    print "weekend"
  }
  2 {
    print "monday"
  }
  else {
    print "weekday"
  }
}
for i in 1..3 {
  print i
}
print (3..1)
print nil
print (nil == nil)
print type(1)
print type("s")
print type([1])
print type({"a": 1})

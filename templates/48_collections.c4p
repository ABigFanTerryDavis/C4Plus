# Collection builtins + random
let nums = [5, 3, 9, 1, 3, 7]
print sort(nums)
print (nums[0] == 5)
print reverse(nums)
print ("sum=" + str(sum(nums)))
print ("min=" + str(min_of(nums)) + " max=" + str(max_of(nums)))
print ("index_of 9 = " + str(index_of(nums, 9)))
print ("index_of 4 = " + str(index_of(nums, 4)))
print ("count 3 = " + str(count(nums, 3)))
print unique(nums)
print sort(["pear", "apple", "fig"])
print reverse("C4Plus")
print ("contains list = " + str(contains(nums, 9)))
print ("any zero-ish = " + str(any([0, 0, 3])))
print ("all truthy = " + str(all([1, 2, 3])))
print ("count in string = " + str(count("banana", "an")))

import random
random.seed(42)
let dice = []
for i in 1..10 {
  push(dice, random.int(1, 6))
}
print dice
print ("sorted rolls = " + str(sort(dice)))
print random.pick(["rock", "paper", "scissors"])
print random.shuffle([1, 2, 3, 4, 5])
print ("float in 0..1 = " + str(random.float() >= 0 and random.float() <= 1))
print ("chance 1.0 = " + str(random.chance(1.0)))
print ("chance 0.0 = " + str(random.chance(0.0)))
random.seed(42)
let again = []
for i in 1..5 {
  push(again, random.int(100))
}
print ("same seed again = " + str(again))

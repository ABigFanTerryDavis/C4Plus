# 64_shell — interactive kernel shell: ls/cat/save/rm/clear/help/ver/poweroff.
# Keyboard line input, VGA console, writable FAT12 files. No paging, no timer.
# Build (same shape as 61_ata, but -Os: the write path pushes the kernel
# past 96K at -O0; current MinGW ld also needs --image-base 0x0):
#   c4c --emit-c 64_shell.c4p --freestanding -o sh.c
#   gcc -Os -m32 -ffreestanding -nostdlib -c -o sh.o sh.c -I rt
#   gcc -Os -m32 -ffreestanding -nostdlib -c -o fs.o rt/c4rt_fs.c
#   as --32 rt/irq.s -o irq.o
#   as --32 boot/boot.s -o boot.o
#   ld -m i386pe -T boot/linkflat.ld --image-base 0x0 -o sh.pe sh.o fs.o irq.o
#   objcopy -O binary sh.pe sh.bin
#   ld -m i386pe -T boot/bootlink.ld --image-base 0x0 -o boot.pe boot.o
#   objcopy -O binary -j .boot boot.pe boot.bin
#   cat boot.bin sh.bin(pad 96K) fat12.bin > shdisk.img  (fat base LBA 193;
#     build fat12.bin with: python user/mkfat.py zig-out/fat12.bin user/hello.txt zig-out/user2.elf)
#   qemu-system-i386 -drive format=raw,file=shdisk.img -display none ^
#     -debugcon file:zig-out/sh.log -device isa-debug-exit,iobase=0xf4,iosize=0x04 ^
#     -monitor stdio
# Then type: help, ls, cat hello.txt, save t.txt hi, ls, rm t.txt, ver,
# poweroff (or drive it with monitor sendkey: sendkey s-a-v-e spc ... ret).
# save/rm verified live 0.4.6: typed `save t.txt hi` over sendkey, `ls`
# listed T.TXT, and the host read `hi` back off the image afterwards.
# Expect echoed lines, file text, qemu exit = (code<<1)|1 on poweroff.

fn ata_wait() {
  let t = 0
  while t < 100000 {
    let s = inb(503)
    if (s & 128) == 0 {
      return s
    }
    t = t + 1
  }
  fail("ata timeout")
}

fn ata_read(lba) {
  outb(502, 224 + (lba >> 24))
  outb(498, 1)
  outb(499, lba & 255)
  outb(500, (lba >> 8) & 255)
  outb(501, (lba >> 16) & 255)
  outb(503, 32)
  ata_wait()
  let t = 0
  while t < 100000 {
    let s = inb(503)
    if s & 1 {
      fail("ata err")
    }
    if s & 8 {
      break
    }
    t = t + 1
  }
  let buf = bytes(512)
  let w = 0
  while w < 256 {
    let v = inw(496)
    poke(buf, w * 2, v & 255)
    poke(buf, w * 2 + 1, (v >> 8) & 255)
    w = w + 1
  }
  return buf
}

fn rd16(buf, off) {
  return peek(buf, off) + peek(buf, off + 1) * 256
}

fn rd32(buf, off) {
  return peek(buf, off) + peek(buf, off + 1) * 256 + peek(buf, off + 2) * 65536 + peek(buf, off + 3) * 16777216
}

fn fat12(fat, cl) {
  let off = cl + floor(cl / 2)
  if cl % 2 == 0 {
    return peek(fat, off) + (peek(fat, off + 1) & 15) * 256
  }
  return (peek(fat, off) >> 4) + peek(fat, off + 1) * 16
}

fn wr16(buf, off, v) {
  poke(buf, off, v & 255)
  poke(buf, off + 1, (v >> 8) & 255)
}

fn wr32(buf, off, v) {
  poke(buf, off, v & 255)
  poke(buf, off + 1, (v >> 8) & 255)
  poke(buf, off + 2, (v >> 16) & 255)
  poke(buf, off + 3, (v >> 24) & 255)
}

fn ata_write(lba, buf) {
  outb(502, 224 + (lba >> 24))
  outb(498, 1)
  outb(499, lba & 255)
  outb(500, (lba >> 8) & 255)
  outb(501, (lba >> 16) & 255)
  outb(503, 48)
  ata_wait()
  let t = 0
  while t < 100000 {
    let s = inb(503)
    if s & 1 {
      fail("ata err")
    }
    if s & 8 {
      break
    }
    t = t + 1
  }
  let w = 0
  while w < 256 {
    outw(496, peek(buf, w * 2) + peek(buf, w * 2 + 1) * 256)
    w = w + 1
  }
  let t2 = 0
  while t2 < 100000 {
    let s2 = inb(503)
    if s2 & 1 {
      fail("ata err")
    }
    if (s2 & 128) == 0 {
      return 1
    }
    t2 = t2 + 1
  }
  fail("ata write timeout")
}

fn fat12set(fat, cl, val) {
  let off = cl + floor(cl / 2)
  if cl % 2 == 0 {
    poke(fat, off, val & 255)
    poke(fat, off + 1, (peek(fat, off + 1) & 240) + ((val >> 8) & 15))
  } else {
    poke(fat, off, (peek(fat, off) & 15) + ((val * 16) & 240))
    poke(fat, off + 1, (val >> 4) & 255)
  }
}

fn fat_write(name83, data, size) {
  let root = ata_read(198)
  let fat = bytes(1024)
  let f0 = ata_read(194)
  let f1 = ata_read(195)
  let s = 0
  while s < 512 {
    poke(fat, s, peek(f0, s))
    poke(fat, 512 + s, peek(f1, s))
    s = s + 1
  }
  let slot = -1
  let e = 0
  while e < 16 {
    let b0 = peek(root, e * 32)
    if b0 == 0 {
      if slot == -1 {
        slot = e
      }
      break
    }
    if b0 == 229 {
      if slot == -1 {
        slot = e
      }
    } else {
      let match = 1
      let k = 0
      while k < 11 {
        if peek(root, e * 32 + k) != ord(substr(name83, k, 1)) {
          match = 0
        }
        k = k + 1
      }
      if match {
        slot = e
        let oldcl = rd16(root, e * 32 + 26)
        if oldcl != 0 {
          let c = oldcl
          while c >= 2 and c < 4088 {
            let nx = fat12(fat, c)
            fat12set(fat, c, 0)
            if nx >= 4088 {
              break
            }
            c = nx
          }
        }
        break
      }
    }
    e = e + 1
  }
  if slot == -1 {
    return 0
  }
  let need = floor((size + 511) / 512)
  let chain = bytes(need * 2)
  let got = 0
  let c = 2
  while got < need and c < 508 {
    if fat12(fat, c) == 0 {
      wr16(chain, got * 2, c)
      got = got + 1
    }
    c = c + 1
  }
  if got < need {
    return 0
  }
  let k = 0
  while k < need {
    let nx = 4095
    if k + 1 < need {
      nx = rd16(chain, (k + 1) * 2)
    }
    fat12set(fat, rd16(chain, k * 2), nx)
    let sec = bytes(512)
    let b = 0
    while b < 512 {
      let src = k * 512 + b
      if src < size {
        poke(sec, b, peek(data, src))
      }
      b = b + 1
    }
    ata_write(197 + rd16(chain, k * 2), sec)
    k = k + 1
  }
  let fa = bytes(512)
  let fb = bytes(512)
  let f = 0
  while f < 512 {
    poke(fa, f, peek(fat, f))
    poke(fb, f, peek(fat, 512 + f))
    f = f + 1
  }
  ata_write(194, fa)
  ata_write(196, fa)
  ata_write(195, fb)
  ata_write(197, fb)
  let eo = slot * 32
  let j = 0
  while j < 11 {
    poke(root, eo + j, ord(substr(name83, j, 1)))
    j = j + 1
  }
  poke(root, eo + 11, 32)
  wr16(root, eo + 26, rd16(chain, 0))
  wr32(root, eo + 28, size)
  ata_write(198, root)
  return need
}

fn fat_delete(name83) {
  let root = ata_read(198)
  let fat = bytes(1024)
  let f0 = ata_read(194)
  let f1 = ata_read(195)
  let s = 0
  while s < 512 {
    poke(fat, s, peek(f0, s))
    poke(fat, 512 + s, peek(f1, s))
    s = s + 1
  }
  let e = 0
  while e < 16 {
    if peek(root, e * 32) == 0 {
      break
    }
    let match = 1
    let k = 0
    while k < 11 {
      if peek(root, e * 32 + k) != ord(substr(name83, k, 1)) {
        match = 0
      }
      k = k + 1
    }
    if match {
      let c = rd16(root, e * 32 + 26)
      while c >= 2 and c < 4088 {
        let nx = fat12(fat, c)
        fat12set(fat, c, 0)
        if nx >= 4088 {
          break
        }
        c = nx
      }
      poke(root, e * 32, 229)
      let fa = bytes(512)
      let fb = bytes(512)
      let f = 0
      while f < 512 {
        poke(fa, f, peek(fat, f))
        poke(fb, f, peek(fat, 512 + f))
        f = f + 1
      }
      ata_write(194, fa)
      ata_write(196, fa)
      ata_write(195, fb)
      ata_write(197, fb)
  ata_write(198, root)
  return 1
}
    e = e + 1
  }
  return 0
}

fn to83(name) {
  let parts = split(name, ".")
  let a = upper(parts[0])
  let b = ""
  if len(parts) > 1 {
    b = upper(parts[1])
  }
  while len(a) < 8 {
    a = a + " "
  }
  while len(b) < 3 {
    b = b + " "
  }
  return a + b
}

fn fat_ls() {
  let root = ata_read(198)
  let e = 0
  while e < 16 {
    if peek(root, e * 32) == 0 {
      break
    }
    let nm = ""
    let k = 0
    while k < 11 {
      nm = nm + chr(peek(root, e * 32 + k))
      k = k + 1
    }
    print nm
    e = e + 1
  }
  return e
}

fn fat_read(name83) {
  let root = ata_read(198)
  let fat = ata_read(194)
  let e = 0
  while e < 16 {
    if peek(root, e * 32) == 0 {
      break
    }
    let nm = ""
    let k = 0
    while k < 11 {
      nm = nm + chr(peek(root, e * 32 + k))
      k = k + 1
    }
    if nm == name83 {
      let cl = rd16(root, e * 32 + 26)
      let sz = rd32(root, e * 32 + 28)
      let out = bytes(sz)
      let pos = 0
      while cl < 4088 {
        let sec = ata_read(197 + cl)
        let b = 0
        while b < 512 {
          if pos < sz {
            poke(out, pos, peek(sec, b))
            pos = pos + 1
          }
          b = b + 1
        }
        cl = fat12(fat, cl)
      }
      return out
    }
    e = e + 1
  }
  fail("not found")
}

fn vga_put(r, c, ch, attr) {
  let off = 753664 + (r * 80 + c) * 2
  let a = off - off % 4
  let v = peek32(a)
  let sh = (off - a) * 8
  poke32(a, setbits(v, sh + 15, sh, ch + attr * 256))
}

fn vga_clear(attr) {
  let i = 0
  while i < 500 {
    poke32(753664 + i * 4, 2097184 + attr * 16777472)
    i = i + 1
  }
}

fn vga_scroll() {
  let r = 0
  while r < 24 {
    let i = 0
    while i < 40 {
      poke32(753664 + r * 160 + i * 4, peek32(753664 + (r + 1) * 160 + i * 4))
      i = i + 1
    }
    r = r + 1
  }
  let i = 0
  while i < 40 {
    poke32(753664 + 24 * 160 + i * 4, 119539488)
    i = i + 1
  }
}

fn vga_move(r, c) {
  let pos = r * 80 + c
  outb(980, 14)
  outb(981, (pos >> 8) & 255)
  outb(980, 15)
  outb(981, pos & 255)
}

fn vga_print(s, attr, cur) {
  for ch in s {
    if ord(ch) == 10 {
      cur[1] = 0
      cur[0] = cur[0] + 1
    } else {
      vga_put(cur[0], cur[1], ord(ch), attr)
      cur[1] = cur[1] + 1
      if cur[1] == 80 {
        cur[1] = 0
        cur[0] = cur[0] + 1
      }
    }
    if cur[0] == 25 {
      vga_scroll()
      cur[0] = 24
    }
  }
  vga_move(cur[0], cur[1])
  return cur
}

# NOTE: the input loop below is inlined in the shell body on purpose.
# A `readline()` helper with `while true` + `return` misbehaves when the
# 100Hz timer preempts it under QEMU TCG (rare wrong-branch, ~5%/tick;
# invisible on real hardware and with TB chaining off). Inline spins with
# bounded conditions are solid. See DOCS "QEMU notes".

# PIC: keyboard only (timer masked); IDT: keyboard + faults
outb(32, 17)
outb(160, 17)
outb(33, 32)
outb(161, 40)
outb(33, 4)
outb(161, 2)
outb(33, 1)
outb(161, 1)
outb(33, 253)
outb(161, 255)
idt_set(33, irq1_addr(), 8, 142)
let v = 0
while v < 32 {
  idt_set(v, fault_addr(v), 8, 142)
  v = v + 1
}
idt_load()
sti()
vga_clear(7)
let cur = [0, 0]
vga_print("c4plus shell 0.4.0", 15, cur)
vga_print(chr(10), 7, cur)
print "shell on"
while true {
  vga_print("c4> ", 10, cur)
  let line = ""
  let gotline = 0
  while gotline == 0 {
    let k = key()
    if k != -1 {
      if k == 10 {
        vga_print(chr(10), 7, cur)
        gotline = 1
      } else {
        if k == 8 {
          if len(line) > 0 {
            line = substr(line, 0, len(line) - 1)
            cur[1] = cur[1] - 1
            if cur[1] < 0 {
              cur[1] = 0
            } else {
              vga_put(cur[0], cur[1], 32, 7)
              vga_move(cur[0], cur[1])
            }
          }
        } else {
          line = line + chr(k)
          vga_print(chr(k), 7, cur)
        }
      }
    }
  }
  print ("got [" + line + "]")
  let parts = split(line, " ")
  let cmd = parts[0]
  if cmd == "help" {
    vga_print("help ls cat save rm clear ver poweroff", 7, cur)
    vga_print(chr(10), 7, cur)
    print "help ok"
  } elif cmd == "ls" {
    fat_ls()
    print "ls ok"
  } elif cmd == "cat" {
    if len(parts) > 1 {
      let data = fat_read(to83(parts[1]))
      let s = ""
      let i = 0
      while i < len(data) {
        s = s + chr(peek(data, i))
        i = i + 1
      }
      vga_print(s, 7, cur)
      print "cat ok"
    } else {
      vga_print("usage: cat file", 7, cur)
      vga_print(chr(10), 7, cur)
    }
  } elif cmd == "clear" {
    vga_clear(7)
    cur[0] = 0
    cur[1] = 0
  } elif cmd == "save" {
    if len(parts) > 2 {
      let text = parts[2]
      let pi = 3
      while pi < len(parts) {
        text = text + " " + parts[pi]
        pi = pi + 1
      }
      let buf = bytes(len(text))
      let bi = 0
      while bi < len(text) {
        poke(buf, bi, ord(substr(text, bi, 1)))
        bi = bi + 1
      }
      let took = fat_write(to83(parts[1]), buf, len(text))
      if took == 0 {
        vga_print("save failed (no space)", 7, cur)
      } else {
        vga_print("saved", 7, cur)
      }
      vga_print(chr(10), 7, cur)
      print "save ok"
    } else {
      vga_print("usage: save name text...", 7, cur)
      vga_print(chr(10), 7, cur)
    }
  } elif cmd == "rm" {
    if len(parts) > 1 {
      if fat_delete(to83(parts[1])) {
        vga_print("removed", 7, cur)
      } else {
        vga_print("not found", 7, cur)
      }
      vga_print(chr(10), 7, cur)
      print "rm ok"
    } else {
      vga_print("usage: rm name", 7, cur)
      vga_print(chr(10), 7, cur)
    }
  } elif cmd == "ver" {
    vga_print("c4plus 0.4.0 shell", 7, cur)
    vga_print(chr(10), 7, cur)
    print "ver ok"
  } elif cmd == "poweroff" {
    print "bye"
    exit(0)
  } else {
    if len(line) > 0 {
      vga_print("unknown cmd", 7, cur)
      vga_print(chr(10), 7, cur)
    }
  }
}

# 60_http — fetch JSON over HTTP, post a form, download a file.
# Needs a local demo server (saves you from depending on the internet):
#   save this as ht_serve.py and run `python ht_serve.py`:
#     from http.server import BaseHTTPRequestHandler, HTTPServer
#     import json
#     class H(BaseHTTPRequestHandler):
#         def _send(self, code, body, ctype="text/plain"):
#             data = body.encode()
#             self.send_response(code)
#             self.send_header("Content-Type", ctype)
#             self.send_header("Content-Length", str(len(data)))
#             self.end_headers()
#             if self.command != "HEAD":
#                 self.wfile.write(data)
#         def do_GET(self):
#             if self.path == "/time":
#                 self._send(200, "{\"ok\": 1}", "application/json")
#             else:
#                 self._send(404, "nope")
#         def do_POST(self):
#             n = int(self.headers.get("Content-Length", 0))
#             self._send(201, "got:" + self.rfile.read(n).decode())
#         def do_HEAD(self):
#             self._send(200, "x")
#         def log_message(self, *a):
#             pass
#     HTTPServer(("127.0.0.1", 8471), H).serve_forever()
# Then: c4c 60_http.c4p
# Expect: status lines, the echoed post, header reads, a downloaded
# file (time.json), and caught errors for bad urls. All network
# failures are catchable with try/catch — statuses like 404 are
# normal return values, not errors.

import http
import json

# GET json and parse it (try/catch so `c4c check` passes offline too)
let r = http.get("http://localhost:8471/time")
print ("code=" + str(r["code"]))
print ("ctype=" + r["headers"]["content-type"])
let m = {"ok": 0}
try {
  m = json.parse(r["body"])
} catch e {
  print ("parse note: " + e)
}
print ("ok=" + str(m["ok"]))

# POST a form body, read the echo
let p = http.post("http://localhost:8471/post", "name=c4plus")
print ("post=" + str(p["code"]) + " " + p["body"])

# HEAD: status + headers, no body key work needed
let h = http.head("http://localhost:8471/time")
print ("head=" + str(h["code"]) + " len=" + h["headers"]["content-length"])

# 404 is data, not an error
let q = http.get("http://localhost:8471/nowhere")
print ("missing=" + str(q["code"]))

# download straight to disk
let dl = http.download("http://localhost:8471/time", "time.json")
print ("saved " + str(dl["bytes"]) + " bytes to " + dl["path"])

# failures you can catch
try {
  http.get("notaurl")
} catch e {
  print ("caught: " + e)
}
try {
  http.get("http://localhost:9/nothing-here")
} catch e {
  print ("caught: " + e)
}
print ("redirects=" + str(http.redirects()))

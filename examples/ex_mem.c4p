# mem basics: arena bump, typed access, slab pool, catchable bounds errors
import mem
let a = mem.arena(64)
let o1 = mem.alloc(a, 10)
let o2 = mem.alloc(a, 5)
print ("o1=" + str(o1) + " o2=" + str(o2))
mem.write_u32(a, o1, 305419896)
print ("r32=" + str(mem.read_u32(a, o1)))
print ("r16=" + str(mem.read_u16(a, o1)))
print ("r8=" + str(mem.read_u8(a, o1 + 3)))
mem.fill(a, o2, 5, 65)
mem.copy(a, 40, o2, 5)
print ("f=" + str(mem.read_u8(a, 40)))
print ("c=" + str(mem.read_u8(a, 44)))
print mem.usage(a)
let p = mem.pool(8, 4)
let s1 = mem.acquire(p)
let s2 = mem.acquire(p)
print ("s=" + str(s1) + "," + str(s2))
mem.write_u16(p, s1 * 8, 1234)
print ("slot=" + str(mem.read_u16(p, s1 * 8)))
let r1 = mem.release(p, s1)
print ("rel=" + str(r1))
let r2 = mem.release(p, s1)
print ("rel2=" + str(r2))
print mem.usage(p)
mem.reset(a)
print mem.usage(a)
try { mem.read_u8(a, 999) } catch e { print ("caught: " + e) }
print ("oom=" + str(mem.alloc(a, 1000000)))

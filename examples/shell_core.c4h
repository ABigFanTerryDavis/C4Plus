# shell_core.c4h — pure xos shell logic (freestanding-safe)
# No input/import/try here, only fs builtins (split/trim/lower/int/str).
# Runners: hosted examples/shell.c4p, kernel examples/shell_fs.c4p.
# "__EXIT__" / "__CLEAR__" are sentinels the runner acts on.
fn is_num(s) {
  if len(s) == 0 {
    return 0
  }
  let i = 0
  if s[0] == "-" {
    if len(s) == 1 {
      return 0
    }
    i = 1
  }
  while i < len(s) {
    if s[i] < "0" {
      return 0
    }
    if s[i] > "9" {
      return 0
    }
    i = i + 1
  }
  return 1
}

fn cmd_help() {
  return "commands: help, echo <text>, add <a> <b>, clear, version, whoami, exit"
}

fn cmd_version() {
  return "xos shell v0.1 (c4p)"
}

fn run_cmd(line) {
  let t = trim(line)
  if len(t) == 0 {
    return ""
  }
  let parts = split(t, " ")
  let cmd = lower(parts[0])
  if cmd == "help" {
    return cmd_help()
  }
  if cmd == "version" {
    return cmd_version()
  }
  if cmd == "whoami" {
    return "derlinus"
  }
  if cmd == "exit" {
    return "__EXIT__"
  }
  if cmd == "clear" {
    return "__CLEAR__"
  }
  if cmd == "echo" {
    if len(parts) == 1 {
      return ""
    }
    let rest = substr(t, len(parts[0]) + 1, len(t))
    return trim(rest)
  }
  if cmd == "add" {
    if len(parts) != 3 {
      return "usage: add <a> <b>"
    }
    if is_num(parts[1]) == 0 {
      return "add: not a number"
    }
    if is_num(parts[2]) == 0 {
      return "add: not a number"
    }
    return str(int(parts[1]) + int(parts[2]))
  }
  return "unknown: " + parts[0]
}

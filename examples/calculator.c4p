fn calc(a, op, b) {
  if op == "+" {
    return a + b
  }
  if op == "-" {
    return a - b
  }
  if op == "*" {
    return a * b
  }
  if op == "/" {
    return a / b
  }
  if op == "%" {
    return a % b
  }
  return 0
}

print calc(6, "*", 7)
print calc(10, "+", 5)
print calc(10, "-", 4)
print calc(20, "/", 4)
print calc(7, "%", 3)
print (2 + 3 * 4)
print ((2 + 3) * 4)
